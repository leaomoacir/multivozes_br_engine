# ==============================================================================
# Multivozes BR Engine - Configurações de Ambiente (.env)
# ==============================================================================

# --- Configurações de Rede e Servidor ---
PORT=5050
# BIND_ADDRESS no Docker Compose:
# 0.0.0.0 = Permite conexões locais, de outros contêineres Docker (ex: n8n) e pela rede.
# 127.0.0.1 = Restringe o acesso exclusivamente à máquina local.
BIND_ADDRESS=0.0.0.0
HOST=0.0.0.0

# --- Autenticação (Opcional para uso local / contêineres internos) ---
# Se API_KEY estiver vazia e REQUIRE_API_KEY=False, nenhuma chave será exigida.
# Para proteger o serviço em redes públicas, defina uma chave e mude para True.
API_KEY=
REQUIRE_API_KEY=False

# --- Motor de Síntese de Voz (100% Gratuito) ---
# 'auto' (Recomendado): Tenta Edge-TTS neural de alta qualidade. Se houver erro
#                       (ex: erro 403 / bloqueio de IP de VPS pela Microsoft),
#                       aciona automaticamente o fallback para gTTS sem quebrar o n8n.
# 'gtts': Usa diretamente o Google Translate TTS via HTTP padrão. Ideal para VPS/Hetzner
#         onde a Microsoft bloqueia ativamente conexões WebSocket.
# 'edge': Usa exclusivamente Edge-TTS (sem fallback).
TTS_ENGINE=auto

# --- Padrões de Síntese de Voz ---
DEFAULT_VOICE=pt-BR-ThalitaMultilingualNeural
DEFAULT_RESPONSE_FORMAT=mp3
DEFAULT_SPEED=1.0

# --- Configurações do Motor gTTS (Google Translate) ---
DEFAULT_GTTS_LANG=pt
DEFAULT_GTTS_TLD=com.br

# --- Filtros de Texto e Limites Operacionais ---
# False remove emojis e tags Markdown antes da leitura. True envia texto puro.
REMOVE_FILTER=False

# Limites por requisição
MAX_INPUT_CHARS=10000
MAX_REQUEST_BYTES=131072
TTS_TIMEOUT_SECONDS=90
MAX_CONCURRENT_TTS=4

# --- Proxy Opcional de Saída ---
# PROXY=http://usuario:senha@host:porta

# --- Nome da Rede Docker Compartilhada ---
# DOCKER_NETWORK=multivozes_net
